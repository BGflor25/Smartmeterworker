{
  "Meter": {
    "PortName": "/dev/ttyUSB0",
    "BaudRate": 115200,
    "DtrEnable": true,
    "RtsEnable": true,
    "ReadTimeout": "00:00:15",
    "Interval": "00:05:00",
    "ApiUrl": "http://192.168.20.157:8080/api/meterdata/upload"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  }
}
